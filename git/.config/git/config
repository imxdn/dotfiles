[core]
	pager = delta

[interactive]
	diffFilter = delta --color-only

[delta]
	features = ayu-dark
	line-numbers = true
	side-by-side = true

[delta "ayu-dark"]
	dark = true
	syntax-theme = ayu-dark
	syntax-theme = base16
	file-style = "#BFBDB6"
	file-decoration-style = "#5A6378" ul
	file-added-label = [+]
	file-modified-label = [*]
	file-removed-label = [-]
	file-renamed-label = [→]
	hunk-header-decoration-style = "#0D1017" box
	hunk-header-file-style = "#5A6673"
	hunk-header-line-number-style = "#FFB454"
	hunk-header-style = file line-number syntax
	line-numbers-minus-style = "#F07178"
	line-numbers-plus-style = "#AAD94C"
	line-numbers-left-style = "#5A6378"
	line-numbers-right-style = "#5A6378"
	line-numbers-zero-style = "#5A6673"
	minus-style = syntax "#3d1f24"
	minus-emph-style = syntax "#4d2730"
	plus-style = syntax "#1f3d28"
	plus-emph-style = syntax "#274d32"
	zero-style = syntax
	whitespace-error-style = "#eb6f92" reverse

[merge]
	conflictstyle = diff3

[diff]
	colorMoved = default
